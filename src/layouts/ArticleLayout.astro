---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate, isoDate, type Article } from '../lib/articles';
import { sectionBySlug, seriesBySlug } from '../data/site';
import { withBase } from '../lib/url';

interface Props { article: Article }
const { article } = Astro.props;
const { title, section, series, date, excerpt, author, sources } = article.data;
const sec = sectionBySlug(section)!;
const ser = series ? seriesBySlug(series) : undefined;
const crumbs = [
  { label: 'Home', href: withBase('/') },
  { label: sec.title, href: withBase(sec.href) },
  ...(ser ? [{ label: ser.title, href: withBase(ser.href) }] : []),
  { label: title },
];
---

<BaseLayout title={title} description={excerpt} type="article">
  <PageHeader title={title} deck={excerpt} crumbs={crumbs}>
    <p class="byline">
      {author && <span>By {author}</span>}
      {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
    </p>
  </PageHeader>
  <div class="container article">
    <div class="prose"><slot /></div>
    <aside class="satire-note" aria-labelledby="satire-title">
      <h2 class="h-minor" id="satire-title">A note on satire</h2>
      <p>
        This is satire. Exaggeration, parody and invented scenarios are part of the joke. Any quotation not tied to a
        cited source is fictional.
      </p>
    </aside>
    <section class="evidence" aria-labelledby="evidence-title">
      <h2 class="h-minor" id="evidence-title">Sources and references</h2>
      {sources.length > 0 ? (
        <ol class="evidence__list">
          {sources.map((s) => (
            <li>
              {s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}
              {s.note && <span class="evidence__note">{s.note}</span>}
            </li>
          ))}
        </ol>
      ) : (
        <p>This article cites no external sources.</p>
      )}
    </section>
  </div>
</BaseLayout>
