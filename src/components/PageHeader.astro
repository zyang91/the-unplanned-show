---
interface Props {
  title: string;
  // Small label above the headline, e.g. the article kind.
  kicker?: string;
  deck?: string;
  crumbs?: { label: string; href?: string }[];
  // Centres the head on the article reading column.
  narrow?: boolean;
}
const { title, kicker, deck, crumbs, narrow = false } = Astro.props;
---

<header class:list={['page-head container', { 'page-head--narrow': narrow }]}>
  {crumbs && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
  )}
  {kicker && <p class="kind">{kicker}</p>}
  <h1>{title}</h1>
  {deck && <p class="page-head__deck">{deck}</p>}
  <slot />
</header>
