---
import type { Article } from '../lib/articles';
import { formatDate, isoDate } from '../lib/articles';
import { sectionBySlug, seriesBySlug } from '../data/site';
import { withBase } from '../lib/url';

interface Props { article: Article; showSection?: boolean }
const { article, showSection = true } = Astro.props;
const { title, section, series, date, excerpt } = article.data;
const sec = sectionBySlug(section);
const ser = series ? seriesBySlug(series) : undefined;
---

<article class="story">
  <h3 class="story__title"><a href={withBase(`/articles/${article.id}/`)}>{title}</a></h3>
  <p class="story__meta">
    {showSection && sec && <span>{sec.title}</span>}
    {showSection && ser && <span>{ser.title}</span>}
    {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
  </p>
  {excerpt && <p class="story__excerpt">{excerpt}</p>}
</article>
