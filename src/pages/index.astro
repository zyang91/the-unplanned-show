---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StaffReport from '../components/StaffReport.astro';
import TileMap from '../components/TileMap.astro';
import { coverOf, formatDate, getPublished, isoDate, type Article } from '../lib/articles';
import { KINDS, SECTIONS, SITE, sectionBySlug, seriesBySlug } from '../data/site';
import { withBase } from '../lib/url';

const stories = await getPublished();
// Opinion pieces live in their own right-hand column; everything else is news.
const opinions = stories.filter((a) => a.data.kind === 'opinion').slice(0, 5);
const news = stories.filter((a) => a.data.kind !== 'opinion');
const [lead, ...rest] = news;
const leftStories = rest.slice(0, 3);
const latest = stories.slice(0, 8);

const filed = Object.fromEntries(SECTIONS.map((s) => [s.slug, stories.filter((a) => a.data.section === s.slug).length]));
const href = (id: string) => withBase(`/articles/${id}/`);

// The small label above a headline: the series for Unplanned School (MCP, MUSA, Research), else the section.
const kicker = (a: Article) =>
  a.data.series.length > 0
    ? a.data.series.map((s) => seriesBySlug(s)?.short).join(' · ')
    : (sectionBySlug(a.data.section)?.title ?? '');
const byline = (a: Article) => (a.data.author ? `By ${a.data.author}` : formatDate(a.data.date!));
const leadSection = lead ? sectionBySlug(lead.data.section) : undefined;

// One block per section, laid out like a broadsheet inside page: a text story on the left,
// a pictured story on the right, then a row of further headlines.
const desks = SECTIONS.map((s) => {
  const list = news.filter((a) => a.data.section === s.slug);
  const pictured = list.find((a) => coverOf(a));
  const text = list.find((a) => a !== pictured) ?? pictured;
  const more = list.filter((a) => a !== pictured && a !== text).slice(0, 3);
  return { s, text, pictured: pictured && pictured !== text ? pictured : undefined, soloCover: pictured === text ? pictured : undefined, more };
});

// More stories: a pictured story, a list beside it, and the editorial report on the right.
const morePictured = news.find((a) => a !== lead && coverOf(a)) ?? news.find((a) => coverOf(a));
const moreCover = morePictured ? coverOf(morePictured) : undefined;
const moreList = news.filter((a) => a !== morePictured).slice(0, 6);

// Pre-launch stand-ins keep the strip populated until stories are filed.
const placeholders = [
  { kicker: 'In committee', title: 'Planning continues despite uncertain results' },
  { kicker: 'Pending review', title: 'Studio deliverable declared a work in progress' },
  { kicker: 'Under study', title: 'Public comment period extended, then forgotten' },
  { kicker: 'Deferred', title: 'Model achieves 94% accuracy; decision still unmade' },
];
---

<BaseLayout>
  <div class="container front">
    <section class="front__left" aria-labelledby="lead-title">
      {lead ? (
        <>
          {leadSection && (
            <p class="desk-kicker"><a href={withBase(leadSection.href)}>{leadSection.title} <span aria-hidden="true">›</span></a></p>
          )}
          <h1 class="lead__title" id="lead-title"><a href={href(lead.id)}>{lead.data.title}</a></h1>
          {lead.data.excerpt && <p class="lead__deck">{lead.data.excerpt}</p>}
          <p class="lead__by">{byline(lead)}</p>
        </>
      ) : (
        <>
          <p class="desk-kicker">Breaking News</p>
          <h1 class="lead__title" id="lead-title">Planning Continues Despite Uncertain Results.</h1>
          <p class="lead__deck">Our first stories are still in committee, pending further study.</p>
          <p class="lead__by">By the editors</p>
        </>
      )}
      <ul class="stack">
        {leftStories.length > 0
          ? leftStories.map((a) => (
              <li>
                <span class="item-kicker">{kicker(a)}</span>
                <a href={href(a.id)}>{a.data.title}</a>
              </li>
            ))
          : SECTIONS.map((s) => (
              <li>
                <span class="item-kicker">{s.title}</span>
                <a href={withBase(s.href)}>{s.tagline}</a>
              </li>
            ))}
      </ul>
    </section>

    <div class="front__center">
      <TileMap filed={filed} />
    </div>

    <aside class="front__right" aria-labelledby="opinion-title">
      <h2 class="desk-kicker desk-kicker--rule" id="opinion-title">Opinions</h2>
      {opinions.length > 0 ? (
        <ul class="rail">
          {opinions.map((a) => (
            <li class="rail__item">
              <span class="item-kicker">{a.data.author ?? 'The editors'}</span>
              <a class="rail__title" href={href(a.id)}>{a.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rail-empty">
          <p>Longer, more serious pieces, argued straight. The first opinion is in committee.</p>
          <p><a href={`${SITE.github}/blob/main/CONTRIBUTING.md`}>Submit an opinion</a></p>
        </div>
      )}
    </aside>
  </div>

  <section class="container latest" aria-labelledby="latest-title">
    <header class="latest__head">
      <h2 class="latest__title" id="latest-title">The Latest</h2>
      <span class="latest__badge">Pre-launch</span>
      <p class="latest__tag">Fresh from the desk, such as it is.</p>
    </header>
    <ol class="latest__row">
      {latest.length > 0
        ? latest.map((a) => (
            <li class="latest__item">
              <p class="latest__by">{sectionBySlug(a.data.section)?.title}{a.data.series.map((s) => ` · ${seriesBySlug(s)?.title}`).join('')}</p>
              <time class="latest__time" datetime={isoDate(a.data.date!)}>{formatDate(a.data.date!)}</time>
              {a.data.kind && <p class="kind">{KINDS[a.data.kind]}</p>}
              <a class="latest__link" href={href(a.id)}>{a.data.title}</a>
            </li>
          ))
        : placeholders.map((p) => (
            <li class="latest__item">
              <p class="latest__by latest__by--new">{p.kicker}</p>
              <span class="latest__link">{p.title}</span>
              <p class="latest__slug">No story filed.</p>
            </li>
          ))}
    </ol>
  </section>

  {desks.map(({ s, text, pictured, soloCover, more }) => {
    const coverStory = pictured ?? soloCover;
    const cover = coverStory ? coverOf(coverStory) : undefined;
    const coverHref = coverStory ? href(coverStory.id) : undefined;
    return (
      <section class="container desk" aria-labelledby={`${s.slug}-head`}>
        <h2 class="desk-kicker desk-kicker--head" id={`${s.slug}-head`}>
          <a href={withBase(s.href)}>The {s.title} latest <span aria-hidden="true">›</span></a>
        </h2>
        {text ? (
          <>
            <div class="desk__top">
              <article class="desk__text">
                <span class="item-kicker">{kicker(text)}</span>
                <h3 class="desk__title"><a href={href(text.id)}>{text.data.title}</a></h3>
                {text.data.excerpt && <p class="desk__deck">{text.data.excerpt}</p>}
                <p class="lead__by">{byline(text)}</p>
              </article>
              {cover && coverHref && (
                <figure class="desk__fig">
                  <a href={coverHref} tabindex="-1" aria-hidden="true">
                    <Image class="desk__img" src={cover.src} alt="" widths={[480, 800, 1200]} sizes="(max-width: 60rem) 100vw, 860px" />
                  </a>
                  {pictured && (
                    <figcaption>
                      <span class="item-kicker">{kicker(pictured)}</span>
                      <h3 class="desk__fig-title"><a href={href(pictured.id)}>{pictured.data.title}</a></h3>
                    </figcaption>
                  )}
                </figure>
              )}
            </div>
            {more.length > 0 && (
              <ul class="desk__row">
                {more.map((a) => (
                  <li>
                    <span class="item-kicker">{kicker(a)}</span>
                    <a href={href(a.id)}>{a.data.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <div class="desk__top">
            <div class="desk__text">
              <span class="item-kicker">Position reserved</span>
              <p class="desk__title">{s.tagline}</p>
              <p class="desk__deck">No story filed. {s.summary}</p>
            </div>
            <div class="desk__fig desk__fig--empty" aria-hidden="true"><span>Photo pending further study</span></div>
          </div>
        )}
      </section>
    );
  })}

  <div class="container more">
    <section class="more__main" aria-labelledby="more-title">
      <h2 class="desk-kicker desk-kicker--rule" id="more-title">More Stories</h2>
      {news.length > 0 ? (
        <div class="more__grid">
          {morePictured && moreCover && (
            <figure class="more__fig">
              <a href={href(morePictured.id)} tabindex="-1" aria-hidden="true">
                <Image class="desk__img" src={moreCover.src} alt="" widths={[480, 800]} sizes="(max-width: 60rem) 100vw, 480px" />
              </a>
              <figcaption>
                <span class="item-kicker">{kicker(morePictured)}</span>
                <h3 class="desk__fig-title"><a href={href(morePictured.id)}>{morePictured.data.title}</a></h3>
              </figcaption>
            </figure>
          )}
          <ul class="more__list">
            {moreList.map((a) => (
              <li>
                {a.data.kind && <span class="kind">{KINDS[a.data.kind]}</span>}
                <a href={href(a.id)}>{a.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="slot__slug">No stories filed.</p>
      )}
    </section>

    <aside class="more__side" aria-label="Editorial report">
      <StaffReport published={stories.length} />
      <div class="note-box">
        <p>Everything is satire. Evidence is listed. Images may be AI-generated.</p>
        <p>{SITE.disclaimer}</p>
        <p><a href={withBase('/editorial-policy/')}>Read the editorial policy</a></p>
      </div>
    </aside>
  </div>
</BaseLayout>
